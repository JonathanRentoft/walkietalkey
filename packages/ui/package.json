{
  "name": "@walkietalkey/ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "WalkieTalkey design system as typed React components, tokens and assets.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./components.css": "./src/styles/components.css",
    "./extensions.css": "./src/styles/extensions.css",
    "./assets/*": "./assets/*",
    "./build/assets": "./build/assets.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "assets",
    "build",
    "tokens"
  ],
  "scripts": {
    "gen:tokens": "bun scripts/gen-tokens.ts",
    "check:tokens": "bun scripts/gen-tokens.ts --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "visual": "bun scripts/visual/build.ts && bun scripts/visual/compare.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
