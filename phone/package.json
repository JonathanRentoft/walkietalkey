{
  "name": "@walkietalkey/phone",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "WalkieTalkey phone web app (PWA): hold the button, talk, and the audio goes end-to-end encrypted to your computer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "bun scripts/serve.ts dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "bun run build:e2e && playwright test",
    "deploy": "WRANGLER_SEND_METRICS=false wrangler pages deploy dist --project-name walkietalkey-app --branch main",
    "deploy:domain": "WRANGLER_SEND_METRICS=false wrangler deploy --config wrangler.domain.jsonc"
  },
  "dependencies": {
    "@walkietalkey/protocol": "workspace:*",
    "@walkietalkey/ui": "workspace:*",
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.0.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
