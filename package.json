{
  "name": "walkietalkey",
  "private": true,
  "version": "0.2.2",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "phone",
    "relay",
    "site",
    "training/studio"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test:keyboard": "bun src/lib/utils/keyboard.test.ts",
    "test:wt": "bun test src/walkietalkey",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:recorder": "playwright test -c training/e2e",
    "test:studio": "playwright test -c training/e2e/studio.config.ts",
    "check:translations": "bun scripts/check-translations.ts",
    "copy:list": "bun scripts/walkietalkey/copy-list.ts",
    "check:copy": "bun scripts/walkietalkey/copy-list.ts --check",
    "check:model-languages": "bun scripts/check-model-language-coverage.ts",
    "sync:catalog": "bun scripts/sync-catalog.ts",
    "check:catalog": "bun scripts/sync-catalog.ts --check"
  },
  "dependencies": {
    "@handy-computer/models": "0.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.5.0",
    "@tauri-apps/plugin-dialog": "~2.8",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "@tauri-apps/plugin-global-shortcut": "~2.4.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-sql": "~2.6.0",
    "@tauri-apps/plugin-store": "~2.5.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "i18next": "^26.5.4",
    "immer": "^11.2.6",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.8.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/react-select": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-i18next": "^6.1.5",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
