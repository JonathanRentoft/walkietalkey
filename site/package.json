{
  "name": "@walkietalkey/site",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "walkietalkey.com: static Astro site with React islands from @walkietalkey/ui.",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "bun scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "bun scripts/lighthouse.ts",
    "deploy": "WRANGLER_SEND_METRICS=false wrangler pages deploy dist --project-name walkietalkey-site --branch main",
    "deploy:domain": "WRANGLER_SEND_METRICS=false wrangler deploy --config wrangler.domain.jsonc",
    "deploy:www": "WRANGLER_SEND_METRICS=false wrangler deploy --config www/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@walkietalkey/ui": "workspace:*",
    "astro": "^7.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.9.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "node-html-parser": "^9.0.5",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
