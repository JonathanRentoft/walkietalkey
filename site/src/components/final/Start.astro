---
/* Run 8: concept C's getting started and price, side by side on the design system's GradientBars (glow, Morgengry):
   bars of light rising from the bottom of a light panel, instead of C's dark brown silk.
     Kom i gang på et minut: three steps; flip the two permissions the app asks for, and the third step is ready.
     Gratis for alle, også for virksomheder: 0 kr. for 1.000 computere, a slider for how many computers (the price
     stays 0 kr. however far you slide it, principle 3), the two cards, and "Hjælpen er en service, ikke en licens".
   Without JavaScript both show their finished state: the permissions on, the price for 1.000 computers. The bars are
   one of the page's living backgrounds ([data-fp-bg], final.ts). */
import { GradientBars, Keycap, ShinyButton } from "@walkietalkey/ui";
import { Check } from "../home/Icons";
import { CTA, FEATURES, PLANS, STEPS, TRY } from "../../lib/features";
import { CONTACT_URL, PAGES } from "../../lib/site";

interface Props {
  class?: string;
}
/* how many computers the slider steps through; it starts at the last, 1.000 */
const COUNTS = [1, 2, 5, 10, 25, 50, 100, 250, 500, 1000];
const fmt = new Intl.NumberFormat("da-DK");
const start = COUNTS.length - 1;
const count = TRY.many.replace("{n}", fmt.format(COUNTS[start]));
---
<section class:list={["fp-get", Astro.props.class]} id="kom-i-gang" aria-labelledby="fp-kom-i-gang">
  <div class="fp-get-panel" data-fp-bg="bars" data-paused>
    <GradientBars variant="glow" palette="morgengry" bars={36} className="fp-get-surface">
      <div class="fp-get-grid">
        <div class="fp-start" data-feature="start" data-start data-ready-text={TRY.ready} data-wait-text={TRY.waiting}>
          <h2 class="fp-h2 fp-get-h2" id="fp-kom-i-gang">{FEATURES.start.title}</h2>
          <p class="fp-text">{FEATURES.start.body}</p>
          <ol class="fp-steps">
            <li class="fp-step">
              <span class="fp-step-n" aria-hidden="true">1</span>
              <div>
                <h3>{STEPS[0].title}</h3>
                <p>{STEPS[0].body}</p>
                <a class="fp-link" href={PAGES.hent.path}>{TRY.get}</a>
              </div>
            </li>
            <li class="fp-step">
              <span class="fp-step-n" aria-hidden="true">2</span>
              <div>
                <h3>{STEPS[1].title}</h3>
                <p>{STEPS[1].body}</p>
                <div class="fp-perms" role="group" aria-label={TRY.permissionsTitle}>
                  <span class="fp-tag fp-js-only">{TRY.permissionsTitle}</span>
                  {TRY.permissions.map((p) => (
                    <button type="button" class="fp-switch" role="switch" aria-checked="true" data-perm>
                      <span class="fp-switch-track" aria-hidden="true"><span class="fp-switch-knob"></span></span>
                      <span>{p}</span>
                    </button>
                  ))}
                </div>
              </div>
            </li>
            <li class="fp-step" data-final data-ready>
              <span class="fp-step-n" aria-hidden="true">3</span>
              <div>
                <h3>{STEPS[2].title}</h3>
                <p>{STEPS[2].body}</p>
                <p class="fp-ready"><Keycap size={36} className="fp-ready-key">fn</Keycap><span data-ready-label aria-live="polite">{TRY.ready}</span></p>
              </div>
            </li>
          </ol>
        </div>

        <div class="fp-free" data-feature="free" data-free data-counts={JSON.stringify(COUNTS)} data-one={TRY.one} data-many={TRY.many}>
          <h2 class="fp-h2 fp-get-h2">{FEATURES.free.title}</h2>
          <div class="fp-price">
            <span class="fp-price-n" data-price>{PLANS.free.price}</span>
            <span class="fp-price-for" data-count>{count}</span>
          </div>
          <div class="fp-range fp-js-only">
            <label for="fp-count">{TRY.countLabel}</label>
            <input id="fp-count" type="range" min="0" max={COUNTS.length - 1} step="1" value={start} aria-valuetext={count} data-range />
            <p class="fp-range-hint" data-hint data-text={TRY.hint} aria-live="polite">{TRY.hint}</p>
          </div>
          <div class="fp-plans">
            <div class="fp-plan">
              <h3>{PLANS.free.title}</h3>
              <p class="fp-plan-price">{PLANS.free.price}</p>
              <p class="fp-plan-note">{PLANS.free.note}</p>
              <ul>{PLANS.free.items.map((s) => <li><Check s={16} />{s}</li>)}</ul>
              <div class="fp-plan-ctas">
                <ShinyButton variant="ink" href={PAGES.hent.path}>{CTA.download}</ShinyButton>
              </div>
            </div>
            <div class="fp-plan fp-plan--help" data-help data-lit>
              <h3>{PLANS.help.title}</h3>
              <p class="fp-plan-price">{PLANS.help.price}</p>
              <p class="fp-plan-note">{PLANS.help.note}</p>
              <ul>{PLANS.help.items.map((s) => <li><Check s={16} />{s}</li>)}</ul>
              <div class="fp-plan-ctas">
                <ShinyButton variant="glass" icon={false} href={CONTACT_URL}>{CTA.contact}</ShinyButton>
                <a class="fp-link" href={PAGES.business.path}>{CTA.business}</a>
              </div>
            </div>
          </div>
          <p class="fp-plans-foot">{PLANS.footnote}</p>
        </div>
      </div>
    </GradientBars>
  </div>
</section>
