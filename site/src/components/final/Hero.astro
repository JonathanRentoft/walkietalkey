---
/* Run 8: the hero of all three final pages, concept B's: the slogan, the product in one sentence, two buttons and the
   fine print over the lit stage with the laptop and the phone (Stage.astro). Everything in it is static HTML and
   paints without JavaScript. Only its background differs per page, and that is a React island that starts when the
   browser is idle, after load:
     waves   LightWaves in Morgengry on night, the light lifted under the words
     bars    BarField in wave mode with 40 bars, interactive: still until the visitor moves, then it settles again
     metal   FluidMesh in Nat, following the pointer, calm on the left (the design system's ForsideMetal)
   The background is one of the page's living backgrounds ([data-fp-bg], final.ts), so it rests while another is the
   most visible one. */
import { ShinyButton } from "@walkietalkey/ui";
import Live from "./Live";
import Stage from "./Stage.astro";
import { CTA, FINE_PRINT, ONE_LINER, SLOGAN } from "../../lib/features";
import { PAGES } from "../../lib/site";

interface Props {
  bg: "waves" | "bars" | "metal";
  /** where "Sådan virker det" goes: the features on this page */
  how: string;
}
const { bg, how } = Astro.props;
const dark = bg !== "bars";
---
<section class="fp-hero" data-section="hero" data-fp-hero={bg} data-theme={dark ? "dark" : undefined} aria-labelledby="fp-h1">
  <div class="fp-hero-panel">
    <div class="fp-hero-bg" data-fp-bg={bg === "metal" ? "mesh" : bg} data-paused>
      {bg === "waves" && <Live client:idle kind="waves" palette="morgengry" intensity={0.8} lift={0.06} sensitivity={0.8} grain={0.03} />}
      {bg === "bars" && <Live client:idle kind="bars" mode="wave" bars={40} interactive palette="morgengry" intensity={0.5} gap={8} />}
      {bg === "metal" && <Live client:idle kind="mesh" palette="nat" scrim="left" scrimAmount={1} />}
    </div>
    <div class="fp-hero-copy">
      <h1 class="fp-h1" id="fp-h1">{SLOGAN}</h1>
      <p class="fp-lead">{ONE_LINER}</p>
      <div class="fp-ctas">
        <ShinyButton variant="ink" size="lg" href={PAGES.hent.path}>{CTA.download}</ShinyButton>
        <ShinyButton variant="glass" size="lg" icon={false} href={how}>{CTA.how}</ShinyButton>
      </div>
      <p class="fp-fine">{FINE_PRINT}</p>
    </div>
    <Stage />
  </div>
</section>
