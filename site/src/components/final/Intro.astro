---
/* Run 8: the production front page's intro over its features: "Lavet til den måde, du taler på". */
import { SHOWCASE_INTRO } from "../../lib/features";

interface Props {
  /** centred over the features, a column of its own beside them, or the heading and the lead side by side */
  align?: "center" | "start" | "split";
  id?: string;
}
const { align = "center", id = "funktioner" } = Astro.props;
---
<header class:list={["fp-intro", `fp-intro--${align}`]}>
  <p class="fp-eyebrow">{SHOWCASE_INTRO.eyebrow}</p>
  <h2 class="fp-h2" id={id}>{SHOWCASE_INTRO.title}</h2>
  <p class="fp-intro-lead">{SHOWCASE_INTRO.lead}</p>
  <slot />
</header>
