---
/* The production front page's intro over its features, "Lavet til den måde, du taler på": the heading on the left and
   the lead under it, so the first row's words start in the same column. */
import { SHOWCASE_INTRO } from "../../lib/features";
---
<header class="fp-intro">
  <p class="fp-eyebrow">{SHOWCASE_INTRO.eyebrow}</p>
  <h2 class="fp-h2" id="funktioner">{SHOWCASE_INTRO.title}</h2>
  <p class="fp-intro-lead">{SHOWCASE_INTRO.lead}</p>
</header>
