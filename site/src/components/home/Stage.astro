---
/* The signature animation (run 5): words appear on the Mac while someone talks into the phone. Built from the design
   system's own parts (PhoneFrame, PhoneApp, LaptopFrame, DictationPill and the desktop scene's classes), rendered to
   static HTML at build time; lib/stage.ts steps data-step through the timeline and home.css does the moving. The HTML
   holds the calm final step, so without JavaScript or with reduced motion the finished text simply stands there.

   The picture is drawn at a fixed design size and scaled to its box with CSS (home.css), so it takes its space before
   anything loads and never shifts the page. On a phone it uses a taller layout, so the words stay readable.

   The app shows phone dictations when the user lets go (DESK-52, DESK-56), and transcribes while they talk (DESK-61);
   the words appearing faintly while the phone records stand for that, and turn solid when the text is ready. */
import { DictationPill, LaptopFrame, Logo, PHONE_LABELS, PhoneApp, PhoneFrame } from "@walkietalkey/ui";
import { STAGE_WORDS } from "../../lib/stage";

const computer = "MacBook";
const fill = (s: string) => s.replace("{computer}", computer).replace("{key}", "⌘V");
/* spec Appendix A (Phone), as the phone app says them */
const say: [string, string][] = [
  ["idle", fill(PHONE_LABELS.idle)],
  ["rec", fill(PHONE_LABELS.rec)],
  ["send", fill(PHONE_LABELS.send)],
  ["ready", fill(PHONE_LABELS.ready)],
];
const pasteHint = fill(PHONE_LABELS.pasteHint);
/* the design system's mic and check icons (PhoneApp's face) */
const MIC = "M8 1.8a2.3 2.3 0 0 1 2.3 2.3v3.5a2.3 2.3 0 0 1-4.6 0V4.1A2.3 2.3 0 0 1 8 1.8ZM3.6 7.3a4.4 4.4 0 0 0 8.8 0M8 11.8v2.4";
const CHECK = "M3.4 8.4 6.5 11.3 12.6 4.8";
// TODO(copy): the picture's description for screen readers
const label =
  "Du holder knappen i WalkieTalkey på telefonen og taler. Imens bliver det, du siger, til tekst på computeren, og når du slipper, ligger teksten klar til at indsætte med ⌘V.";
---
<div class="stage" data-stage data-step="ready" role="img" aria-label={label}>
  <div class="stage-box">
    <div class="stage-in" aria-hidden="true">
      <LaptopFrame width={760} className="st-mac">
        <div class="wt-desk">
          <div class="wt-mbar">
            <span class="wt-mbar-left"><i class="wt-mbar-dot"></i><b>Post</b><span>Arkiv</span><span>Rediger</span><span>Vis</span></span>
            <span class="wt-mbar-right"><span class="wt-mbar-wt"><Logo variant="mark" tone="ink" size={11} decorative /></span><span>tor. 22. okt. 10.24</span></span>
          </div>
          <div class="wt-win st-win">
            <div class="wt-win-bar"><span class="wt-win-dots"><i></i><i></i><i></i></span><span class="wt-win-title">Ny besked</span></div>
            <div class="wt-win-field"><span>Til:</span><b class="wt-win-chip">Mette Holm</b></div>
            <div class="wt-win-field"><span>Emne:</span><b>Mødet i morgen</b></div>
            <div class="wt-win-body st-body">
              <i class="wt-caret st-caret"></i>
              <p class="st-words" data-words>{STAGE_WORDS.map((w, i) => <><span class="w" style={`--i:${i}`}>{w}</span>{" "}</>)}</p>
            </div>
          </div>
          <div class="st-pills">
            <DictationPill state="listening" seconds={0} mark className="st-pill st-pill--rec" />
            <DictationPill state="processing" mark className="st-pill st-pill--send" />
            <DictationPill state="ready" className="st-pill st-pill--ready" />
          </div>
        </div>
      </LaptopFrame>
      <PhoneFrame width={250} screen="dark" className="st-phone">
        <PhoneApp state="ready" device={computer} />
        <span class="st-face">
          <svg class="st-ico st-ico--mic" viewBox="0 0 16 16" width="16" height="16"><path d={MIC} /></svg>
          <svg class="st-ico st-ico--check" viewBox="0 0 16 16" width="16" height="16"><path d={CHECK} /></svg>
        </span>
        <span class="st-say">{say.map(([k, s]) => <span data-for={k}>{s}</span>)}</span>
        <span class="st-hint"><span>{pasteHint}</span></span>
      </PhoneFrame>
    </div>
  </div>
</div>
<script is:inline>
  /* Start the story from the beginning before the first paint, unless motion is reduced (lib/stage.ts plays it). */
  (function () {
    var s = document.currentScript && document.currentScript.previousElementSibling;
    if (s && window.matchMedia && matchMedia("(prefers-reduced-motion: no-preference)").matches && "IntersectionObserver" in window)
      s.setAttribute("data-step", "idle");
  })();
</script>
<script>
  import { play } from "../../lib/stage";

  const stage = document.querySelector<HTMLElement>("[data-stage]");
  const hero = stage?.closest<HTMLElement>("[data-section]");
  if (stage && hero) play(stage, hero);
</script>
