---
/* The front page's first section (run 5): the navigation, the italic W mark, one idea in words, two buttons and the
   signature animation, over the page's one living surface, a slow liquid gradient in silver and brown (LiquidBackground,
   Morgengry). The words are run 5's fn-led hero (lib/hero.ts). The gradient rests when the hero is out of sight (data-paused) and stands still with reduced motion. */
import { AppIcon, LiquidBackground, ShinyButton } from "@walkietalkey/ui";
import Header from "../Header.astro";
import Stage from "./Stage.astro";
import { HERO } from "../../lib/hero";
import { PAGES } from "../../lib/site";

const copy = HERO;
/** "{fn}" in the copy becomes a keycap */
const parts = (s: string) => s.split("{fn}");
const long = copy.title.length > 24;
---
<header class="hero" data-section="hero" data-hero="fn">
  <LiquidBackground className="hero-bg" palette="morgengry" />
  <Header current="home" />
  <div class="hero-copy container" id="indhold">
    <AppIcon className="hero-mark" />
    <h1 class:list={["hero-h1", { "hero-h1--long": long }]}>{copy.title}</h1>
    <p class="hero-lead">{parts(copy.lead).map((p, i) => <>{i > 0 && <kbd class="key">fn</kbd>}{p}</>)}</p>
    <p class="hero-second">{parts(copy.second).map((p, i) => <>{i > 0 && <kbd class="key">fn</kbd>}{p}</>)}</p>
    <div class="ctas">
      <ShinyButton variant="ink" size="lg" href={PAGES.hent.path}>Hent gratis</ShinyButton>
      <ShinyButton variant="glass" size="lg" icon={false} href={PAGES.how.path}>Sådan virker det</ShinyButton>
    </div>
    <p class="hero-fine">{copy.fine}</p>
  </div>
  <div class="container hero-stage"><Stage /></div>
</header>
