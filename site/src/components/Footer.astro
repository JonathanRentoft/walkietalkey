---
/* The footer: the still lockup on every page (run 5: the front page's only motion is its hero, so LogoIntro no longer
   plays here). The navigation reaches every page, GitHub and the contact, kontakt@walkietalkey.com (SITE-05). */
import { Logo } from "@walkietalkey/ui";
import { CONTACT_URL, FOOTER_NAV, PAGES, REPO_URL, SITE_URL } from "../lib/site";

const domain = new URL(SITE_URL).host;
---
<footer class="foot">
  <div class="container foot-in">
    <div>
      <Logo variant="lockup" size={30} />
      <small>© 2026 WalkieTalkey · Apache-2.0 · {domain}</small>
    </div>
    <!-- TODO(copy): aria-label -->
    <nav aria-label="Alle sider">
      {FOOTER_NAV.map((k) => <a href={PAGES[k].path}>{PAGES[k].nav}</a>)}
      <a href={REPO_URL}>GitHub</a>
      <a href={CONTACT_URL}>Kontakt</a>
    </nav>
  </div>
</footer>
