---
/* Run 6, concept B: the set. A laptop and a phone on a silver stage, with the props a shot needs (the fn key, ⌘ and V,
   a second screen far back, the word list), built from the design system's own parts (LaptopFrame, PhoneFrame,
   PhoneApp, DictationPill, Notice, Keycap) and rendered to static HTML at build time. It is drawn once at a fixed
   design size (WORLD in scenes.ts) and every shot films it with its own camera (the rectangles in scenes.ts, fitted by .ps-world in stage.css).

   Elements with class ps-k play the shot's sequence (stage.css): ps-k-idle, -hold, -rel and -land show in that phase
   only. Their base style is the finished state, so the HTML alone shows the scene finished. */
import {
  DictationPill,
  Keycap,
  LaptopFrame,
  Logo,
  Notice,
  PhoneApp,
  PhoneFrame,
} from "@walkietalkey/ui";
import { PRODUCT, SAMPLES } from "../../lib/features";
import {
  ENGLISH,
  NAMES,
  SHOTS,
  STAGE,
  WORD_LIST,
  WORD_LIST_TITLE,
  marked,
  type Rect,
  type ShotKey,
} from "./scenes";

interface Props {
  shot: ShotKey;
}
const { shot } = Astro.props;
const d = SHOTS[shot];
const computer = "MacBook";
const fill = (s: string) => s.replace("{computer}", computer);

const pills = shot === "fn" || shot === "corrections" || shot === "mixed" || shot === "words";
const text = shot === "corrections" || shot === "mixed" || shot === "words";
const phone = shot === "hero" || shot === "phone";
const live = pills;
/* the camera's rectangles; stage.css turns them into the transform (scenes.ts: Rect) */
const rect = (k: string, r?: Rect) => (r ? `--${k}x:${r[0]};--${k}y:${r[1]};--${k}w:${r[2]}px;--${k}h:${r[3]}px;` : "");
const style = rect("w", d.wide) + rect("w1", d.wide1) + rect("t", d.tall) + rect("t1", d.tall1);

/* the design system's line icons (1.5 to 1.7 px, round ends, currentColor) */
const ICON = {
  check: "M3.4 8.4 6.5 11.3 12.6 4.8",
  wand: "M2.6 13.4 10 6M9 3.2v1.6M12.8 7v1.6M11.6 4.4l1.1-1.1M13.6 3.2h-1.6",
  book: "M3 2.6h7.6a1.8 1.8 0 0 1 1.8 1.8v9H4.6A1.6 1.6 0 0 1 3 11.8ZM3 11.8a1.6 1.6 0 0 1 1.6-1.6h7.8",
};
/* the path the words take from the phone to the computer, in world px */
const ARC = "M 470 420 C 610 150, 930 110, 1170 290";
---
<div class:list={["ps-world", `ps-world--${shot}`, { "ps-k": shot !== "hero" }]} style={style} aria-hidden="true">
  <span class="ps-shade ps-shade--laptop"></span>
  {phone && <span class="ps-shade ps-shade--phone"></span>}

  {shot === "notify" && (
    <div class="ps-mon">
      <div class="ps-mon-screen"><span class="ps-mon-bar"></span><span class="ps-mon-win"></span></div>
      <span class="ps-mon-neck"></span>
      <span class="ps-mon-foot"></span>
    </div>
  )}

  <div class="ps-laptop">
    <LaptopFrame width={880}>
      <div class="wt-desk">
        <div class="wt-mbar">
          <span class="wt-mbar-left"><i class="wt-mbar-dot"></i><b>Post</b><span>Arkiv</span><span>Rediger</span><span>Vis</span></span>
          <span class="wt-mbar-right">
            <span class="wt-mbar-wt"><Logo variant="mark" tone="ink" size={11} decorative />{live && <i class="ps-live ps-k ps-k-hold"></i>}</span>
            <span>tor. 22. okt. 10.24</span>
          </span>
        </div>

        <div class:list={["wt-win", "ps-win", { "ps-win--big": text }]}>
          <div class="wt-win-bar"><span class="wt-win-dots"><i></i><i></i><i></i></span><span class="wt-win-title">{STAGE.newMessage}</span></div>
          <div class="wt-win-field"><span>Til:</span><b class="wt-win-chip">{STAGE.to}</b></div>
          <div class="wt-win-field"><span>Emne:</span><b>{STAGE.subject}</b></div>
          <div class="wt-win-body ps-body">
            {shot === "hero" || shot === "phone" ? <i class="wt-caret"></i> : <i class="wt-caret ps-caret ps-k ps-k-pre"></i>}
            {shot === "fn" && <span class="ps-line ps-k ps-k-paste">{SAMPLES.mail}</span>}
            {shot === "notify" && <span class="ps-line ps-k ps-k-paste">{SAMPLES.phone}</span>}
            {shot === "corrections" && <span class="ps-line ps-k ps-k-paste">{SAMPLES.correctionWritten}</span>}
            {shot === "mixed" && (
              <span class="ps-line ps-k ps-k-paste">{marked(SAMPLES.mixed, ENGLISH).map((p) => (p.mark ? <span class="ps-en">{p.t}</span> : p.t))}</span>
            )}
            {shot === "words" && (
              <span class="ps-line ps-k ps-k-paste">{marked(SAMPLES.wordsWritten, NAMES).map((p) => (p.mark ? <span class="ps-name">{p.t}</span> : p.t))}</span>
            )}
            {shot !== "hero" && shot !== "phone" && <i class="wt-caret ps-caret-end ps-k ps-k-land"></i>}
            {shot === "corrections" && (
              <span class="ps-chip ps-k ps-k-land"><svg viewBox="0 0 16 16" width="16" height="16"><path d={ICON.wand} /></svg>AI-oprydning</span>
            )}
            {shot === "mixed" && (
              <span class="ps-chip ps-k ps-k-land"><svg viewBox="0 0 16 16" width="16" height="16"><path d={ICON.book} /></svg>Udviklerord</span>
            )}
          </div>
        </div>

        {shot === "words" && (
          <div class="ps-list">
            <div class="ps-list-head"><Logo variant="mark" tone="ink" size={12} decorative /><b>{WORD_LIST_TITLE}</b></div>
            {WORD_LIST.map((w) => (
              <div class:list={["ps-list-row", { "ps-list-row--hit ps-k": NAMES.includes(w.word) }]}>
                {w.said && <span class="ps-list-said">{w.said}</span>}
                <span class="ps-list-word">{w.word}</span>
                {NAMES.includes(w.word) && <svg class="ps-list-ok" viewBox="0 0 16 16" width="14" height="14"><path d={ICON.check} /></svg>}
              </div>
            ))}
          </div>
        )}

        {(shot === "phone" || shot === "notify") && (
          <Notice show preview={SAMPLES.phone} className={shot === "phone" ? "ps-notice ps-k" : "ps-notice"} />
        )}

        {shot === "hero" && (
          <div class="ps-pills"><DictationPill state="idle" /></div>
        )}
        {pills && (
          <div class="ps-pills">
            <DictationPill state="listening" className="ps-k ps-k-hold" />
            <DictationPill state="processing" className="ps-k ps-k-rel" />
            <DictationPill state="pasted" className="ps-k ps-k-land" />
          </div>
        )}
      </div>
    </LaptopFrame>
  </div>

  {phone && (
    <div class:list={["ps-phone", { "ps-ph": shot === "phone" }]}>
      <PhoneFrame width={260} screen="dark">
        <PhoneApp state="idle" device={computer} />
        {shot === "phone" && (
          <>
            <span class="ps-ph-face ps-k ps-k-land"><svg viewBox="0 0 16 16"><path d={ICON.check} /></svg></span>
            <span class="ps-ph-say">
              <span class="ps-k ps-k-idle">{PRODUCT.phoneHold}</span>
              <span class="ps-k ps-k-hold">{PRODUCT.phoneRelease}</span>
              <span class="ps-k ps-k-rel"><span class="wt-wait"><i></i><i></i><i></i></span>{fill(PRODUCT.phoneSending)}</span>
              <span class="ps-k ps-k-land">{fill(PRODUCT.phoneReady)}</span>
            </span>
            <span class="ps-ph-sub ps-k ps-k-land"><span>{PRODUCT.pressPaste}</span></span>
          </>
        )}
      </PhoneFrame>
    </div>
  )}

  {shot === "phone" && (
    <>
      <svg class="ps-arc ps-k ps-k-rel" viewBox="0 0 1800 1000" width="1800" height="1000"><path d={ARC} /></svg>
      <span class="ps-spark ps-k" style={`offset-path: path('${ARC}')`}></span>
    </>
  )}

  {shot === "fn" && (
    <>
      <span class="ps-shade ps-shade--key" style="--x: 1274px"></span>
      <div class="ps-key ps-key--fn"><Keycap size={128}>fn</Keycap></div>
    </>
  )}
  {shot === "notify" && (
    <>
      <span class="ps-shade ps-shade--key" style="--x: 1120px; --w: 300px"></span>
      <span class="ps-shade ps-shade--key" style="--x: 1310px"></span>
      <div class="ps-key ps-key--cmd"><Keycap size={128} wide>⌘</Keycap></div>
      <div class="ps-key ps-key--v"><Keycap size={128}>V</Keycap></div>
    </>
  )}
</div>
