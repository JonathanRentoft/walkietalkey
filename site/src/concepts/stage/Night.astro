---
/* Run 6, concept B: the lights go down. Privacy as an annotated product shot on a night stage: the phone locks the
   audio, it crosses the relay unreadable, and the words are made on the computer; the four facts that hold (spec 2.6)
   sit next to the part of the picture they are about. Then open source: the same computer opened to its own code. */
import { DictationPill, Grain, LaptopFrame, Logo, PhoneApp, PhoneFrame } from "@walkietalkey/ui";
import { CTA, FEATURES, PRIVACY_FACTS } from "../../lib/features";
import { PAGES, REPO_URL } from "../../lib/site";
import { STAGE } from "./scenes";

/* the four facts, placed by what they are about: the phone's side on the left, the computer's on the right */
const [local, encrypted, noAudio, noAccount] = PRIVACY_FACTS;
const ICON = {
  lock: "M4.6 7.2V5.3a3.4 3.4 0 0 1 6.8 0v1.9M3.6 7.2h8.8v6.3H3.6Z",
  laptop: "M3 4.2h10v6.6H3ZM1.6 12.6h12.8",
  phone: "M5 1.8h6v12.4H5ZM7.2 12.2h1.6",
  trash: "M3 4.6h10M6.2 4.6V3h3.6v1.6M4.4 4.6l.6 8.8h6l.6-8.8",
};
const facts = [
  { f: encrypted, icon: ICON.lock, side: "l" },
  { f: noAccount, icon: ICON.phone, side: "l" },
  { f: local, icon: ICON.laptop, side: "r" },
  { f: noAudio, icon: ICON.trash, side: "r" },
];
/* the path through the relay, in the diagram's design px: wide, and folded up on a phone */
const ARC = "M 214 190 C 262 40, 520 30, 574 196";
const ARC_TALL = "M 150 124 C 170 20, 470 4, 530 150";
// TODO(copy): the pictures' descriptions for screen readers
const privacyLabel =
  "Telefonen krypterer lyden og sender den gennem relæet til din computer. Relæet kan ikke læse den. Talen bliver til tekst på computeren.";
const ossLabel = "En computer med WalkieTalkeys kode åben, og licensen Apache-2.0.";
const tree = ["crates", "docs", "models", "packages", "phone", "relay", "site", "src", "src-tauri"];
const license = [
  "",
  "                                 Apache License",
  "                           Version 2.0, January 2004",
  "                        http://www.apache.org/licenses/",
  "",
  "   TERMS AND CONDITIONS FOR USE, REPRODUCTION, AND DISTRIBUTION",
  "",
  "   1. Definitions.",
  "",
  "      \"License\" shall mean the terms and conditions for use,",
  "      reproduction, and distribution as defined by Sections 1",
  "      through 9 of this document.",
];
---
<section class="ps-night" data-theme="dark" data-ps-live aria-labelledby="ps-privatliv">
  <div class="ps-night-panel">
    <div class="ps-light ps-light--night" aria-hidden="true"><i></i><i></i><i></i></div>
    <Grain />

    <article class="ps-priv" data-feature="privacy">
      <header class="ps-priv-head">
        <p class="ps-kicker">{PAGES.privacy.nav}</p>
        <h2 class="ps-h2" id="ps-privatliv">{FEATURES.privacy.title}</h2>
        <p class="ps-text">{FEATURES.privacy.body}</p>
      </header>

      <div class="ps-priv-stage">
        <div class="ps-dia" role="img" aria-label={privacyLabel}>
          <div class="ps-dia-in" aria-hidden="true">
            <span class="ps-dia-shade" style="--x: 132px; --w: 230px"></span>
            <span class="ps-dia-shade" style="--x: 800px; --w: 640px"></span>
            <div class="ps-dia-phone">
              <PhoneFrame width={170} screen="dark"><PhoneApp state="send" device="MacBook" /></PhoneFrame>
            </div>
            <div class="ps-dia-laptop">
              <LaptopFrame width={540}>
                <div class="wt-desk">
                  <div class="wt-mbar">
                    <span class="wt-mbar-left"><i class="wt-mbar-dot"></i><b>Post</b><span>Arkiv</span></span>
                    <span class="wt-mbar-right"><span class="wt-mbar-wt"><Logo variant="mark" tone="ink" size={11} decorative /></span><span>10.24</span></span>
                  </div>
                  <div class="ps-dia-pill"><DictationPill state="processing" mark /></div>
                </div>
              </LaptopFrame>
            </div>
            <svg class="ps-dia-arc ps-dia-arc--wide" viewBox="0 0 1100 470" width="1100" height="470"><path d={ARC} /></svg>
            <svg class="ps-dia-arc ps-dia-arc--tall" viewBox="0 0 640 470" width="640" height="470"><path d={ARC_TALL} /></svg>
            {[0, 1, 2, 3].map((i) => <span class="ps-packet" style={`offset-path: path('${ARC}'); --tall: path('${ARC_TALL}'); --k: ${i}`}></span>)}
            <div class="ps-relay">
              <svg viewBox="0 0 16 16" width="18" height="18"><path d={ICON.lock} /></svg>
              <b>{STAGE.relay}</b>
              <code>7f·c2·9a·e1</code>
            </div>
          </div>
        </div>
        {facts.map(({ f, icon, side }, i) => (
          <div class={`ps-fact ps-fact--${side} ps-fact--${i + 1}`}>
            <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path d={icon} /></svg>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
      <p class="ps-more"><a href={PAGES.privacy.path}>{STAGE.privacyMore}</a></p>
    </article>

    <article class="ps-oss" data-feature="oss">
      <div class="ps-oss-copy">
        <p class="ps-kicker">Apache-2.0</p>
        <h2 class="ps-h2">{FEATURES.oss.title}</h2>
        <p class="ps-text">{FEATURES.oss.body}</p>
        <p class="ps-more"><a href={REPO_URL}>{CTA.repo}</a></p>
      </div>
      <div class="ps-oss-stage" role="img" aria-label={ossLabel}>
        <div class="ps-oss-box">
          <div class="ps-oss-in" aria-hidden="true">
            <span class="ps-dia-shade" style="--x: 430px; --w: 900px; --y: 548px"></span>
            <LaptopFrame width={760} screen="dark">
              <div class="ps-code">
                <div class="ps-code-side">
                  <span class="ps-code-repo"><Logo variant="mark" tone="paper" size={10} decorative />walkietalkey</span>
                  {tree.map((t) => <span class="ps-code-dir">{t}</span>)}
                  <span class="ps-code-file ps-code-file--on">LICENSE</span>
                  <span class="ps-code-file">README.md</span>
                </div>
                <div class="ps-code-main">
                  <div class="ps-code-tabs"><span class="ps-code-tab">LICENSE</span></div>
                  <pre class="ps-code-text">{license.map((l, i) => <span class="ps-code-ln"><i>{i + 1}</i>{l}</span>)}</pre>
                  <div class="ps-code-status"><span>main</span><span>Apache-2.0</span></div>
                </div>
              </div>
            </LaptopFrame>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
