---
/* Run 6, concept B: one shot of the film. Its words (the feature's title and body from lib/features.ts) and its
   stage, a big lit panel where the set (World.astro) acts the feature out. While the shot passes, both stay pinned and
   the shot's view timeline plays the sequence (stage.css); the words never wait for an animation. */
import { Grain } from "@walkietalkey/ui";
import Claim from "../../components/home/Claim.astro";
import { FEATURES, SLOGAN } from "../../lib/features";
import World from "./World.astro";
import { KICKER, SAYS, SHOTS, type ShotKey } from "./scenes";

interface Props {
  shot: ShotKey;
}
const { shot } = Astro.props;
const d = SHOTS[shot];
const f = FEATURES[d.feature!];
const words = d.said ? d.said.split(" ") : [];
/* the subtitle stays in the finished picture where it explains it: what you said next to what is written */
const stays = shot === "corrections" || shot === "words";
const struck = (w: string) => shot === "corrections" && /^(onsdag|nej),$/.test(w);
/* the film's scrubber: the slogan's three words are the three phases, hold, release and land */
const phases = SLOGAN.split(".").map((w) => w.trim()).filter(Boolean);
---
<article class:list={["ps-shot", `ps-shot--${shot}`, { "ps-shot--sub": words.length > 0 }]} data-feature={f.key} data-ps-shot data-ps-live>
  <div class="ps-pin">
  <div class="ps-copy">
    <div class="ps-copy-in">
      <p class="ps-kicker">{KICKER[shot]}</p>
      <h2 class="ps-h2">{f.title}</h2>
      <p class="ps-text">
        {f.body}
        {f.claim && <> <Claim what={f.claim.what}>{f.claim.text}</Claim></>}
      </p>
    </div>
  </div>
  <div class="ps-panel">
    <div class="ps-light" aria-hidden="true"><i></i><i></i><i></i></div>
    <Grain />
    {words.length > 0 && (
      <div class="ps-scrub" aria-hidden="true">
        {phases.map((w, i) => <span class={`ps-scrub-w ps-k ps-scrub-w--${i + 1}`}><i class={`ps-k ps-scrub-bar ps-scrub-bar--${i + 1}`}></i>{w}</span>)}
      </div>
    )}
    <div class="ps-view" role="img" aria-label={d.label}>
      <div class="ps-rig"><World shot={shot} /></div>
      {words.length > 0 && (
        <div class:list={["ps-sub", "ps-k", { "ps-sub--stay": stays }]} aria-hidden="true">
          <span class="ps-sub-who"><i class="ps-sub-dot ps-k ps-k-pre"></i>{SAYS}</span>
          <span class="ps-sub-text" style={`--n:${words.length}`}>
            {words.map((w, i) => <><span class:list={["ps-w", { "ps-w--x": struck(w) }]} style={`--i:${i}`}>{w}</span>{" "}</>)}
          </span>
        </div>
      )}
    </div>
  </div>
  </div>
</article>
