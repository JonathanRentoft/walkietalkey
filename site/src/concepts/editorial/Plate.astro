---
/* Run 6, concept A (editorial): Fig. 1, the one computer window. A new mail; fn goes down, the pill says "Lytter" and
   the mail stays empty; fn comes up and the line lands at once (DESK-46). The design system's DictationPill and
   Keycap, rendered to static HTML; motion.ts steps data-step, editorial.css does the moving. The HTML holds the
   landed line, so without JavaScript or with reduced motion the finished mail simply stands there. */
import { DictationPill, Keycap } from "@walkietalkey/ui";
import { PRODUCT, SAMPLES } from "../../lib/features";
import { ED } from "./copy";

/* the listening pill shows its word ("Lytter", spec Appendix A) next to the meter, as the brief's demos do */
const labels = { listening: PRODUCT.listening, pasted: PRODUCT.pasted };
---
<figure class="ed-plate" data-ed-plate data-step="landed">
  <div class="ed-shot" role="img" aria-label={ED.plateAria}>
    <div class="ed-win" aria-hidden="true">
      <div class="ed-win-bar"><span class="ed-win-dots"><i></i><i></i><i></i></span><span>{ED.window.title}</span></div>
      <div class="ed-win-field"><span>{ED.window.to}</span><b>{ED.window.toName}</b></div>
      <div class="ed-win-field"><span>{ED.window.subject}</span><b>{ED.window.subjectText}</b></div>
      <div class="ed-win-body">
        <i class="ed-caret ed-caret--wait"></i>
        <p class="ed-line" data-ed-line>{SAMPLES.mail}<i class="ed-caret"></i></p>
      </div>
      <div class="ed-pills">
        <DictationPill state="idle" className="ed-pill ed-pill--idle" />
        <DictationPill state="listening" seconds={0} mark labels={labels} className="ed-pill ed-pill--held" />
        <DictationPill state="pasted" labels={labels} className="ed-pill ed-pill--landed" />
      </div>
    </div>
  </div>
  <figcaption class="ed-cap">
    <span class="ed-cap-text"><b class="ed-cap-fig">{ED.heads.plate}</b> {ED.plateCaption}</span>
    <span class="ed-key" data-ed-key aria-hidden="true"><Keycap size={64}>fn</Keycap></span>
  </figcaption>
</figure>
<script is:inline>
  /* Start Fig. 1 from the beginning before the first paint, unless motion is reduced (motion.ts plays it). */
  (function () {
    var s = document.currentScript && document.currentScript.previousElementSibling;
    if (s && window.matchMedia && matchMedia("(prefers-reduced-motion: no-preference)").matches && "IntersectionObserver" in window)
      s.setAttribute("data-step", "idle");
  })();
</script>
