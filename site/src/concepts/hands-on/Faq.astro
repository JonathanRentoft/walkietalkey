---
/* Concept C (hands-on): the short FAQ (the rest is on /spoergsmaal) and the last call to action. The question nobody
   has measured an answer to yet (whispering) sits in <Claim>: marked in drafts, left out of production. */
import { AppIcon, ShinyButton } from "@walkietalkey/ui";
import Claim from "../../components/home/Claim.astro";
import { CTA, FAQ, FEATURES, FINE_PRINT, SLOGAN } from "../../lib/features";
import { PAGES } from "../../lib/site";
import { HO } from "./copy";
---
<section class="ho-faq" data-feature="faq" aria-labelledby="ho-faq-h">
  <div class="ho-wrap ho-faq-grid">
    <div class="ho-faq-side">
      <p class="ho-eyebrow">{HO.faq.eyebrow}</p>
      <h2 class="ho-h2" id="ho-faq-h">{FEATURES.faq.title}</h2>
      <p class="ho-sec-lead">{FEATURES.faq.short}</p>
      <a class="ho-more ho-more--ink" href={PAGES.faq.path}>{CTA.allQuestions}</a>
    </div>
    <div class="ho-faq-list">
      {FAQ.map((q, i) =>
        q.claim ? (
          <Claim as="div" what={q.claim}>
            <details class="ho-q"><summary>{q.q}</summary><p>{q.a}</p></details>
          </Claim>
        ) : (
          <details class="ho-q" open={i === 0}><summary>{q.q}</summary><p>{q.a}</p></details>
        ),
      )}
    </div>
    <div class="ho-closing">
      <AppIcon size={64} className="ho-closing-icon" />
      <p class="ho-closing-line">{SLOGAN}</p>
      <ShinyButton variant="ink" size="lg" href={PAGES.hent.path}>{CTA.download}</ShinyButton>
      <p class="ho-fine">{FINE_PRINT}</p>
    </div>
  </div>
</section>
