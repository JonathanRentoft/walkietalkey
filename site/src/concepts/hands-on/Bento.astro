---
/* Concept C (hands-on), the features: one bento grid where every tile is a small demo you can touch. Each tile's HTML
   is its finished state (the phone says "Klar på MacBook", the notice has landed, the self-correction is cleaned up,
   the names are spelled right), so a tile makes sense untouched and without JavaScript; demos.ts makes it react.
   The tiles are CSS surfaces (surface-200, one dark tile with data-theme="dark"), so the grid counts as one living
   surface (design system), and nothing here follows the mouse.

   Reading order (and the order on a phone): the phone and where its text lands, the two writing helpers, the word
   list, the key in every program, Danish and English, privacy and the code. */
import { Keycap, Logo, Notice, PhoneApp, PhoneFrame, PHONE_LABELS } from "@walkietalkey/ui";
import Claim from "../../components/home/Claim.astro";
import { CTA, FEATURES, PRIVACY_FACTS, PRODUCT, SAMPLES } from "../../lib/features";
import { PAGES, REPO_URL } from "../../lib/site";
import { HO, fill } from "./copy";

const [home, other] = HO.notify.computers;
const phoneText = {
  idle: PHONE_LABELS.idle,
  rec: PHONE_LABELS.rec,
  send: PHONE_LABELS.send,
  ready: PHONE_LABELS.ready,
  hint: PHONE_LABELS.pasteHint,
  short: HO.hero.short,
};

/* the self-correction: what was said, split into what stays and what the AI cleanup takes out (DESK-83) */
function cut(said: string, written: string): [string, string, string] {
  let a = 0;
  while (a < written.length && said[a] === written[a]) a++;
  /* back to the start of a word, so the cut never splits one */
  while (a > 0 && written[a - 1] !== " ") a--;
  let b = 0;
  while (b < written.length - a && said[said.length - 1 - b] === written[written.length - 1 - b]) b++;
  return [said.slice(0, a), said.slice(a, said.length - b), said.slice(said.length - b)];
}
const [cBefore, cGone, cAfter] = cut(SAMPLES.correctionSaid, SAMPLES.correctionWritten);
const corrSplit = SAMPLES.correctionWritten === cBefore + cAfter;
const corrBody = FEATURES.corrections.body.split(". ").slice(1).join(". ");

/* the word list: the name and the company in the sample, spelled as the list says */
const NAME = "Mette Holm";
const ORG = "Navigent";
const [wBefore, wAfter] = SAMPLES.wordsWritten.includes(NAME) ? SAMPLES.wordsWritten.split(NAME) : [SAMPLES.wordsWritten, ""];

/* Danish and English: the English words of the sample and the word list entry each comes from (Udviklerord) */
const EN: [string, string][] = [
  ["merge", "merger"],
  ["pull request", "pull request"],
  ["standup", "standup"],
  ["deploy", "deployer"],
  ["staging", "staging"],
];
type Piece = { t: string; w?: string };
const mixed: Piece[] = [];
{
  let rest = SAMPLES.mixed;
  for (;;) {
    let best: { i: number; form: string; word: string } | null = null;
    for (const [word, form] of EN) {
      const i = rest.indexOf(form);
      if (i >= 0 && (!best || i < best.i)) best = { i, form, word };
    }
    if (!best) break;
    if (best.i) mixed.push({ t: rest.slice(0, best.i) });
    mixed.push({ t: best.form, w: best.word });
    rest = rest.slice(best.i + best.form.length);
  }
  if (rest) mixed.push({ t: rest });
}
const enWords = EN.filter(([w]) => mixed.some((p) => p.w === w)).map(([w]) => w);

/* what the relay sees: the phone's audio, encrypted (fixed here; demos.ts draws new bytes) */
const NOISE = "9f3a c71e 04bd e85a 2c19 b6f0 7d43 a1e8 5b2c f09d 36a7 c4e1";
const plain = [SAMPLES.phone, SAMPLES.mail, SAMPLES.first];

/* line icons in the design system's style (1.5 to 1.7 px, round ends, currentColor) */
const I = {
  mic: "M8 1.8a2.3 2.3 0 0 1 2.3 2.3v3.5a2.3 2.3 0 0 1-4.6 0V4.1A2.3 2.3 0 0 1 8 1.8ZM3.6 7.3a4.4 4.4 0 0 0 8.8 0M8 11.8v2.4",
  touch: "M8 6.2a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6ZM3.4 8a4.6 4.6 0 1 1 9.2 0 4.6 4.6 0 0 1-9.2 0",
  lock: "M4.6 7.2V5.3a3.4 3.4 0 0 1 6.8 0v1.9M3.6 7.2h8.8v6.3H3.6Z",
  copy: "M5.6 5.6h7v7h-7ZM3.4 10.4V3.4h7",
  code: "M5.6 4.4 2 8l3.6 3.6M10.4 4.4 14 8l-3.6 3.6M9 3 7 13",
  send: "M3 8h9.5M8.75 4.25 12.5 8l-3.75 3.75",
  check: "M3.4 8.4 6.5 11.3 12.6 4.8",
};
const appText = [SAMPLES.mail, SAMPLES.phone, SAMPLES.wordsWritten, SAMPLES.mixed];
---
<section class="ho-bento" aria-labelledby="ho-bento-h">
  <div class="ho-wrap">
    <div class="ho-sec-head">
      <div>
        <p class="ho-eyebrow">{HO.bento.eyebrow}</p>
        <h2 class="ho-h2" id="ho-bento-h">{HO.bento.title}</h2>
      </div>
      <p class="ho-sec-lead">{HO.bento.lead}</p>
    </div>

    <div class="ho-grid">
      <!-- The phone is a microphone: hold its button, and the text lands on the computer you sit at (next tile). -->
      <article class="ho-tile ho-tile--phone" data-feature="phone" data-phone data-text={JSON.stringify(phoneText)} data-sample={SAMPLES.phone}>
        <div class="ho-tile-text">
          <h3>{FEATURES.phone.title}</h3>
          <p>{FEATURES.phone.short} {FEATURES.phone.claim && <Claim what={FEATURES.phone.claim.what}>{FEATURES.phone.claim.text}</Claim>}</p>
        </div>
        <div class="ho-demo ho-demo--phone">
          <span class="ho-try"><svg class="ho-ico" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d={I.touch} /></svg>{HO.try.phone}</span>
          <PhoneFrame width={252} screen="dark" className="ho-phone">
            <PhoneApp state="ready" device={home} buttonProps={{ "aria-label": HO.phone.button, className: "ho-phone-btn" }} />
          </PhoneFrame>
          <template data-mic><svg width="3.6em" height="3.6em" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d={I.mic} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></template>
        </div>
      </article>

      <!-- The text lands as a notification on the computer you sit at, and only there (spec 12.1). -->
      <article class="ho-tile ho-tile--notify" data-feature="notify" data-notify data-names={JSON.stringify(HO.notify.computers)} data-landed={HO.notify.landed}>
        <div class="ho-tile-text">
          <h3>{FEATURES.notify.title}</h3>
          <p>{FEATURES.notify.body}</p>
        </div>
        <div class="ho-demo ho-demo--notify">
          <span class="ho-try"><svg class="ho-ico" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d={I.touch} /></svg>{HO.try.notify}</span>
          <div class="ho-comps">
            {HO.notify.computers.map((name, i) => (
              <div class:list={["ho-comp", i ? "ho-comp--win" : "ho-comp--mac"]} data-comp data-on={i === 0 ? "" : undefined}>
                <div class="ho-comp-screen" aria-hidden="true">
                  {i === 0 ? (
                    <span class="ho-mbar"><Logo variant="mark" tone="ink" size={8} decorative /><i></i><i></i><i></i></span>
                  ) : (
                    <span class="ho-tbar"><i></i><i></i><i></i><i></i></span>
                  )}
                  <Notice show={i === 0} platform={i ? "windows" : "mac"} preview={SAMPLES.phone} title={PRODUCT.ready} />
                </div>
                <span class="ho-comp-base" aria-hidden="true"></span>
                <button type="button" class="ho-comp-hit" aria-pressed={i === 0 ? "true" : "false"} aria-label={fill(HO.notify.sit, { computer: name })}></button>
                <span class="ho-comp-name">{name}<span class="ho-here">{HO.notify.here}</span></span>
              </div>
            ))}
          </div>
          <p class="wt-sr" aria-live="polite" data-live></p>
        </div>
      </article>

      <!-- Self-corrections, only with the optional AI cleanup (spec 6.10, PRIV-04). -->
      <article class="ho-tile ho-tile--corrections" data-feature="corrections" data-corr>
        <div class="ho-tile-text">
          <h3>{FEATURES.corrections.title}</h3>
          <p>{FEATURES.corrections.short}</p>
        </div>
        <div class="ho-demo ho-demo--text">
          <span class="ho-try"><svg class="ho-ico" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d={I.touch} /></svg>{HO.try.corrections}</span>
          <button type="button" class="ho-switch" role="switch" aria-checked="true" data-switch>
            <span class="ho-switch-track" aria-hidden="true"><span class="ho-switch-knob"></span></span>
            <span>AI-oprydning</span>
          </button>
          <div class="ho-said"><span class="ho-tag">{HO.corrections.said}</span><p>{SAMPLES.correctionSaid}</p></div>
          <div class="ho-written">
            <span class="ho-tag">{HO.corrections.written}</span>
            {corrSplit ? (
              <p>{cBefore}<span class="ho-cut" aria-hidden="true" data-cut>{cGone}</span>{cAfter}</p>
            ) : (
              <p>{SAMPLES.correctionWritten}</p>
            )}
          </div>
          <p class="wt-sr" aria-live="polite" data-live data-on={HO.corrections.on} data-off={HO.corrections.off}></p>
        </div>
        <p class="ho-tile-note">{corrBody}</p>
      </article>

      <!-- Your own word list: type a name, and it is spelled your way (DESK-66). -->
      <article class="ho-tile ho-tile--words" data-feature="words" data-words data-name={NAME} data-said={SAMPLES.wordsSaid}>
        <div class="ho-tile-text">
          <h3>{FEATURES.words.title}</h3>
          <p>{FEATURES.words.short}</p>
        </div>
        <div class="ho-demo ho-demo--text">
          <span class="ho-try"><svg class="ho-ico" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d={I.touch} /></svg>{HO.try.words}</span>
          <div class="ho-list">
            <span class="ho-tag">{HO.words.list}</span>
            <ul class="ho-chips" data-chips>
              <li class="ho-chip">{NAME}</li>
              <li class="ho-chip">{ORG}</li>
              <li class="ho-chip">WalkieTalkey</li>
            </ul>
          </div>
          <form class="ho-add" data-add>
            <label class="wt-sr" for="ho-word">{HO.words.label}</label>
            <input id="ho-word" name="ord" type="text" maxlength="28" autocomplete="off" spellcheck="false" placeholder={HO.words.placeholder} />
            <button type="submit">{HO.words.add}</button>
          </form>
          <div class="ho-said"><span class="ho-tag">{HO.words.said}</span><p data-said>{SAMPLES.wordsSaid}</p></div>
          <div class="ho-written"><span class="ho-tag">{HO.words.written}</span><p>{wBefore}<b class="ho-hit" data-hit>{wAfter ? NAME : ""}</b>{wAfter}</p></div>
        </div>
      </article>

      <!-- fn in every program: the text lands where you write (DESK-17); right Ctrl on Windows. -->
      <article class="ho-tile ho-tile--fn" data-feature="fn" data-apps>
        <div class="ho-tile-text">
          <h3>{FEATURES.fn.title}</h3>
          <p>{FEATURES.fn.body}</p>
        </div>
        <div class="ho-demo ho-demo--apps">
          <span class="ho-try"><svg class="ho-ico" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d={I.touch} /></svg>{HO.try.fn}</span>
          <div class="ho-seg" role="group" aria-label={HO.try.fn}>
            {HO.fn.apps.map((a, i) => <button type="button" aria-pressed={i === 0 ? "true" : "false"} data-app={i}>{a}</button>)}
          </div>
          <div class="ho-apps">
            <div class="ho-app ho-app--mail" data-pane="0">
              <div class="ho-app-field"><span>{HO.fn.mailTo}</span><b>{NAME}</b></div>
              <div class="ho-app-field"><span>{HO.fn.mailSubject}</span><b>{HO.fn.subject}</b></div>
              <p class="ho-app-text"><span class="ho-paste">{appText[0]}</span></p>
            </div>
            <div class="ho-app ho-app--chat" data-pane="1" hidden>
              <div class="ho-app-chan">{HO.fn.channel}</div>
              <div class="ho-app-compose"><p class="ho-app-text"><span class="ho-paste">{appText[1]}</span></p><svg class="ho-ico" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d={I.send} /></svg></div>
            </div>
            <div class="ho-app ho-app--doc" data-pane="2" hidden>
              <div class="ho-app-page"><b>{HO.fn.subject}</b><p class="ho-app-text"><span class="ho-paste">{appText[2]}</span></p><i></i><i></i></div>
            </div>
            <div class="ho-app ho-app--code" data-pane="3" hidden>
              <div class="ho-app-lines" aria-hidden="true"><span>12</span><span>13</span><span>14</span></div>
              <div class="ho-app-src"><span class="ho-app-muted">{"function deploy() {"}</span><p class="ho-app-text"><span class="ho-paste">{"// " + appText[3]}</span></p><span class="ho-app-muted">{"}"}</span></div>
            </div>
          </div>
          <div class="ho-keys">
            <span class="ho-key">{HO.fn.mac}<Keycap size={30}>fn</Keycap></span>
            <span class="ho-key">{HO.fn.windows}<span class="ho-key-sep">{HO.fn.right}</span><Keycap size={30} wide>Ctrl</Keycap></span>
          </div>
        </div>
      </article>

      <!-- Danish and English in one sentence (DESK-67, DESK-70): the English words and the word list they come from. -->
      <article class="ho-tile ho-tile--mixed" data-feature="mixed" data-mixed>
        <div class="ho-tile-text">
          <h3>{FEATURES.mixed.title}</h3>
          <p>{FEATURES.mixed.short} {FEATURES.mixed.claim && <Claim what={FEATURES.mixed.claim.what}>{FEATURES.mixed.claim.text}</Claim>}</p>
        </div>
        <div class="ho-demo ho-demo--mixed">
          <span class="ho-try"><svg class="ho-ico" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d={I.touch} /></svg>{HO.try.mixed}</span>
          <p class="ho-mixed" data-sentence>{mixed.map((p) => (p.w ? <mark class="ho-en" data-w={p.w}>{p.t}</mark> : p.t))}</p>
          <div class="ho-list ho-list--en">
            <span class="ho-tag">{HO.mixed.list}</span>
            <div class="ho-chips">{enWords.map((w) => <button type="button" class="ho-chip" aria-pressed="false" data-w={w}>{w}</button>)}</div>
          </div>
        </div>
      </article>

      <!-- Privacy in the four facts that hold (spec 2.6), and what the relay sees: encrypted audio it cannot read. -->
      <article class="ho-tile ho-tile--privacy" data-feature="privacy" data-theme="dark" data-privacy data-samples={JSON.stringify(plain)}>
        <div class="ho-priv-main">
          <div class="ho-tile-text">
            <Logo variant="mark" tone="gradient" size={64} animated={false} decorative className="ho-priv-mark" />
            <h3>{FEATURES.privacy.title}</h3>
          </div>
          <div class="ho-demo ho-demo--priv">
            <div class="ho-priv-row">
              <span class="ho-tag"><svg class="ho-ico" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d={I.lock} /></svg>{HO.privacy.relay}</span>
              <code class="ho-noise" data-noise>{NOISE}</code>
            </div>
            <div class="ho-priv-row">
              <span class="ho-tag">{HO.privacy.computer}</span>
              <p class="ho-plain"><span class="ho-paste" data-plain>{plain[0]}</span></p>
            </div>
            <button type="button" class="ho-mini" data-again><svg class="ho-ico" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d={I.lock} /></svg>{HO.privacy.again}</button>
          </div>
        </div>
        <ul class="ho-facts">
          {PRIVACY_FACTS.map((f) => (
            <li><svg class="ho-ico" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d={I.check} /></svg><div><h4>{f.title}</h4><p>{f.body}</p></div></li>
          ))}
        </ul>
        <a class="ho-more" href={PAGES.privacy.path}>{HO.privacy.more}</a>
      </article>

      <!-- Open source: the command to fetch the code, ready to copy, and the code on GitHub. -->
      <article class="ho-tile ho-tile--oss" data-feature="oss" data-oss>
        <div class="ho-tile-text">
          <h3>{FEATURES.oss.title}</h3>
          <p>{FEATURES.oss.body}</p>
        </div>
        <div class="ho-demo ho-demo--oss">
          <div class="ho-term">
            <div class="ho-term-bar"><svg class="ho-ico" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d={I.code} /></svg><span>{HO.oss.command}</span>
              <button type="button" class="ho-mini ho-mini--light" data-copy data-done={HO.oss.copied}><svg class="ho-ico" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d={I.copy} /></svg><span data-copy-label>{HO.oss.copy}</span></button>
            </div>
            <code class="ho-cmd" data-cmd><span class="ho-cmd-pre">git clone </span><span>{REPO_URL.split("/").map((p, i) => <>{i > 0 && "/"}{i > 2 && <wbr />}{p}</>)}</span></code>
          </div>
          <div class="ho-oss-foot">
            <a class="ho-more ho-more--ink" href={REPO_URL}>{CTA.repo}</a>
            <span class="ho-badge">Apache-2.0</span>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
