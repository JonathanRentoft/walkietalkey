---
/* Concept C (hands-on): getting started and the price, side by side, both something to touch. The steps let you flip
   the two permissions the app asks for, and the third step is ready once both are on. The price has a slider for how
   many computers, and the price stays 0 kr. however far you slide it (principle 3: free for everyone, also companies);
   from a few dozen computers it points at the paid setup help, a service, not a licence. Without JavaScript both show
   their finished state: the permissions on, the price at 0 kr. The price panel has its own slow silk in Rav, the
   living surface of this screen. */
import { GradientBackground, Keycap, ShinyButton } from "@walkietalkey/ui";
import { Check } from "../../components/home/Icons";
import { CTA, FEATURES, PLANS, STEPS } from "../../lib/features";
import { CONTACT_URL, PAGES } from "../../lib/site";
import { HO } from "./copy";

/* how many computers the slider steps through */
const COUNTS = [1, 2, 5, 10, 25, 50, 100, 250, 500, 1000];
---
<section class="ho-get" aria-label={`${FEATURES.start.title}. ${FEATURES.free.title}`}>
  <div class="ho-wrap ho-get-grid">
    <div class="ho-panel ho-panel--start" data-feature="start" data-start data-ready-text={HO.start.ready} data-wait-text={HO.start.waiting}>
      <h2 class="ho-h2">{FEATURES.start.title}</h2>
      <p class="ho-panel-lead">{FEATURES.start.body}</p>
      <ol class="ho-steps">
        <li class="ho-step">
          <span class="ho-step-n" aria-hidden="true">1</span>
          <div>
            <h3>{STEPS[0].title}</h3>
            <p>{STEPS[0].body}</p>
            <a class="ho-more ho-more--ink" href={PAGES.hent.path}>{HO.start.get}</a>
          </div>
        </li>
        <li class="ho-step">
          <span class="ho-step-n" aria-hidden="true">2</span>
          <div>
            <h3>{STEPS[1].title}</h3>
            <p>{STEPS[1].body}</p>
            <div class="ho-perms" role="group" aria-label={HO.start.title}>
              <span class="ho-tag ho-js-only">{HO.start.title}</span>
              {HO.start.permissions.map((p) => (
                <button type="button" class="ho-switch" role="switch" aria-checked="true" data-perm>
                  <span class="ho-switch-track" aria-hidden="true"><span class="ho-switch-knob"></span></span>
                  <span>{p}</span>
                </button>
              ))}
            </div>
          </div>
        </li>
        <li class="ho-step" data-final data-ready>
          <span class="ho-step-n" aria-hidden="true">3</span>
          <div>
            <h3>{STEPS[2].title}</h3>
            <p>{STEPS[2].body}</p>
            <p class="ho-ready"><Keycap size={36} className="ho-ready-key">fn</Keycap><span data-ready-label aria-live="polite">{HO.start.ready}</span></p>
          </div>
        </li>
      </ol>
    </div>

    <div class="ho-panel ho-panel--free" data-feature="free" data-free data-counts={JSON.stringify(COUNTS)} data-one={HO.free.one} data-many={HO.free.many} data-ho-live>
      <GradientBackground palette="rav" className="ho-free-bg" speed={0.8} />
      <div class="ho-free-in">
        <h2 class="ho-h2">{FEATURES.free.title}</h2>
        <div class="ho-price">
          <span class="ho-price-n" data-price>{PLANS.free.price}</span>
          <span class="ho-price-for" data-count>{HO.free.one}</span>
        </div>
        <div class="ho-range ho-js-only">
          <label for="ho-count">{HO.free.label}</label>
          <input id="ho-count" type="range" min="0" max={COUNTS.length - 1} step="1" value="0" aria-valuetext={HO.free.one} data-range />
          <p class="ho-range-hint" data-hint data-text={HO.free.hint} aria-live="polite"></p>
        </div>
        <div class="ho-plans">
          <div class="ho-plan">
            <h3>{PLANS.free.title}</h3>
            <p class="ho-plan-price">{PLANS.free.price}</p>
            <p class="ho-plan-note">{PLANS.free.note}</p>
            <ul>{PLANS.free.items.map((s) => <li><Check s={16} />{s}</li>)}</ul>
            <ShinyButton variant="ink" href={PAGES.hent.path}>{CTA.download}</ShinyButton>
          </div>
          <div class="ho-plan ho-plan--help" data-help>
            <h3>{PLANS.help.title}</h3>
            <p class="ho-plan-price">{PLANS.help.price}</p>
            <p class="ho-plan-note">{PLANS.help.note}</p>
            <ul>{PLANS.help.items.map((s) => <li><Check s={16} />{s}</li>)}</ul>
            <div class="ho-plan-ctas">
              <ShinyButton variant="glass" icon={false} href={CONTACT_URL}>{CTA.contact}</ShinyButton>
              <a class="ho-more ho-more--ink" href={PAGES.business.path}>{CTA.business}</a>
            </div>
          </div>
        </div>
        <p class="ho-plans-foot">{PLANS.footnote}</p>
      </div>
    </div>
  </div>
</section>
