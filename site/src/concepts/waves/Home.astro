---
/* Run 8, page 1: waves. The story told in the order of the slogan. LightWaves lights the stage from below in the hero;
   then the features come in three movements named by the slogan's own words: Tal. (the fn key and the phone),
   Slip. (what happens when you let go: the self-correction, Danish and English, your own words) and Indsæt. (where
   the text lands). The lights go down for privacy, on FluidMesh in Nat that follows the pointer, and come up again
   on the bars of the price; the questions and one last button close it. */
import Header from "../../components/Header.astro";
import End from "../../components/final/End.astro";
import Faq from "../../components/final/Faq.astro";
import Feature from "../../components/final/Feature.astro";
import Hero from "../../components/final/Hero.astro";
import Intro from "../../components/final/Intro.astro";
import Privacy from "../../components/final/Privacy.astro";
import Start from "../../components/final/Start.astro";
import { SLOGAN } from "../../lib/features";
import "../../components/final/final.css";
import "./waves.css";

/* the slogan's three words name the three movements */
const [talk, release, paste] = SLOGAN.split(" ");
---
<script is:inline>document.documentElement.classList.add("fp-js")</script>
<Header current="home" />
<main id="indhold" class="fp-main fw">
  <Hero bg="waves" how="#funktioner" />

  <section class="fw-sec fw-sec--first" aria-labelledby="funktioner">
    <div class="fp-wrap">
      <Intro align="split" />
    </div>
  </section>

  <section class="fw-sec fw-move" aria-label={talk.replace(".", "")}>
    <div class="fp-wrap">
      <p class="fw-word" aria-hidden="true">{talk}</p>
      <div class="fw-rows">
        <Feature id="fn" />
        <Feature id="phone" flip ratio="4 / 3" />
      </div>
    </div>
  </section>

  <section class="fw-sec fw-move" aria-label={release.replace(".", "")}>
    <div class="fp-wrap">
      <p class="fw-word" aria-hidden="true">{release}</p>
      <div class="fw-rows">
        <Feature id="corrections" ratio="16 / 10" />
        <div class="fw-pair">
          <Feature id="mixed" layout="stack" />
          <Feature id="words" layout="stack" ratio="4 / 3" />
        </div>
      </div>
    </div>
  </section>

  <section class="fw-sec fw-move" aria-label={paste.replace(".", "")}>
    <div class="fp-wrap">
      <p class="fw-word" aria-hidden="true">{paste}</p>
      <div class="fw-rows">
        <Feature id="notify" flip ratio="16 / 10" />
        <Feature id="devices" />
      </div>
    </div>
  </section>

  <Privacy bg="mesh" class="fw-privacy" />
  <Start class="fw-get" />
  <Faq class="fw-faq" />
  <End class="fw-end" />
</main>
<script>
  import { run } from "../../components/final/final";
  run();
</script>
