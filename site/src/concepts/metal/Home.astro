---
/* Run 8, page 3: metal. The night first. FluidMesh in Nat bends around the pointer behind the stage, and the dark
   carries straight on into privacy: what you say stays with you, said before anything else. Then the lights come up
   on the features in pairs, following the words' way: the two ways to talk side by side, then where the text lands
   (the notification, the computer you sit at), and last what it writes (the self-correction on its own, Danish and
   English next to your own words). Getting started and the price stand on the bars of light, and the questions and
   a last button close it. */
import Header from "../../components/Header.astro";
import End from "../../components/final/End.astro";
import Faq from "../../components/final/Faq.astro";
import Feature from "../../components/final/Feature.astro";
import Hero from "../../components/final/Hero.astro";
import Intro from "../../components/final/Intro.astro";
import Privacy from "../../components/final/Privacy.astro";
import Start from "../../components/final/Start.astro";
import { SHOWCASE } from "../../lib/features";
import "../../components/final/final.css";
import "./metal.css";
---
<script is:inline>document.documentElement.classList.add("fp-js")</script>
<Header current="home" />
<main id="indhold" class="fp-main fm">
  <Hero bg="metal" how="#funktioner" />
  <Privacy bg="light" class="fm-privacy" />

  <section class="fm-intro" aria-labelledby="funktioner">
    <div class="fp-wrap">
      <Intro />
    </div>
  </section>

  <section class="fm-group" aria-label={`${SHOWCASE.fn.title}. ${SHOWCASE.phone.title}`}>
    <div class="fp-wrap fm-pair">
      <Feature id="fn" layout="stack" ratio="4 / 3" />
      <Feature id="phone" layout="stack" ratio="4 / 3" />
    </div>
  </section>

  <section class="fm-group" aria-label={`${SHOWCASE.notify.title}. ${SHOWCASE.devices.title}`}>
    <div class="fp-wrap fm-pair">
      <Feature id="notify" layout="stack" />
      <Feature id="devices" layout="stack" ratio="4 / 3" />
    </div>
  </section>

  <section class="fm-group fm-group--write" aria-label={`${SHOWCASE.corrections.title}. ${SHOWCASE.mixed.title}. ${SHOWCASE.words.title}`}>
    <div class="fp-wrap fm-rows">
      <Feature id="corrections" ratio="16 / 10" />
      <div class="fm-pair">
        <Feature id="mixed" layout="stack" />
        <Feature id="words" layout="stack" ratio="4 / 3" />
      </div>
    </div>
  </section>

  <Start class="fm-get" />
  <Faq class="fm-faq" />
  <End class="fm-end" />
</main>
<script>
  import { run } from "../../components/final/final";
  run();
</script>
