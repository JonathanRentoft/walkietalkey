---
/* Every page: <head> with title, description, Open Graph, favicon and the preloaded font (SITE-07), the skip link,
   the page itself and the shared footer. Nothing here loads from another origin (SITE-04). */
/* One stylesheet for every page, in a fixed order: the design system, then the site, then the homepage
   (as in the preview, where the page's <style> follows bundle.css). Pages import no CSS of their own, because
   Astro would place a page's stylesheet before the shared one. */
import "@walkietalkey/ui/styles.css";
import "../styles/site.css";
import "../styles/home.css";
import favicon from "@walkietalkey/ui/assets/App-ikoner/favicon.svg?url";
import ogImage from "@walkietalkey/ui/assets/Baggrunde/og-image.jpg?url";
import fontUrl from "@walkietalkey/ui/assets/fonts/albert-sans-latin-wght-normal.woff2?url";
import Footer from "../components/Footer.astro";
import { PAGES, SITE_URL, type PageKey } from "../lib/site";

interface Props {
  page: PageKey | "notFound";
}
const { page } = Astro.props;
const info = page === "notFound"
  // TODO(copy)
  ? { path: "/404", title: "Siden findes ikke · WalkieTalkey", description: "Siden findes ikke. Gå til forsiden af WalkieTalkey." }
  : PAGES[page];
const canonical = new URL(info.path, SITE_URL).href.replace(/\/$/, "") || SITE_URL;
const og = new URL(ogImage, SITE_URL).href;
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{info.title}</title>
    <meta name="description" content={info.description} />
    <link rel="canonical" href={page === "home" ? SITE_URL : canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#faf8f4" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WalkieTalkey" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:title" content={info.title} />
    <meta property="og:description" content={info.description} />
    <meta property="og:url" content={page === "home" ? SITE_URL : canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- TODO(copy) -->
    <meta property="og:image:alt" content="WalkieTalkey. Tal. Slip. Indsæt." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!-- TODO(copy) -->
    <a class="skip" href="#indhold">Gå til indholdet</a>
    <slot />
    <Footer intro={page === "home"} />
  </body>
</html>
