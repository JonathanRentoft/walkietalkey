---
/* Forside. Which front page this build holds is chosen at build time (run 6, lib/build.ts): astro.config.mjs points
   @concept at src/concepts/<name>/, the current front page (production) without SITE_CONCEPT, else one of the three
   concepts for the owner to compare. Base comes first, so the design system's CSS lands before the concept's. */
import Base from "../layouts/Base.astro";
import Home from "@concept/Home.astro";
import { BUILD } from "../lib/build";
---
<Base page="home" concept={BUILD.concept}>
  <Home />
</Base>
