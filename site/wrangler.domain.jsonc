{
  "$schema": "../relay/node_modules/wrangler/config-schema.json",
  // walkietalkey.com (run 2, Phase 6): the same static build as the Pages project walkietalkey-site,
  // served as Workers static assets on a Workers custom domain, because Workers custom domains get
  // their DNS record and certificate from wrangler itself. Deploy: `bun run --cwd site deploy:domain`.
  "name": "walkietalkey-web",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [{ "pattern": "walkietalkey.com", "custom_domain": true }],
}
